{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TauriLogin",
  "version": "0.1.0",
  "identifier": "com.kikyo.taurilogin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "扫码登录 Demo",
        "width": 1000,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#181b20",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "微信/QQ OAuth 扫码登录演示",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
